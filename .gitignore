# Generated packages, runtime downloads, SDK caches, and local recordings
/artifacts/
/releases/
/widget/packages/
/widget/tools/
/widget/checks/
/native-bridge/generated/
**/bin/
**/obj/
.vs/
.vscode/
*.user
*.suo
*.log
*.pfx
*.p12
*.pem
*.key
*.cer
*.msix
*.appx
*.appxsym
