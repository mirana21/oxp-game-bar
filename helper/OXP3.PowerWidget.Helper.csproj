<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OXP3.PowerWidget.Helper</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\shared\DeferredSlider.cs" Link="DeferredSlider.cs" />
    <Compile Include="..\shared\PowerAvailability.cs" Link="PowerAvailability.cs" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <Content Include="..\GameDiscovery.psm1" Link="GameDiscovery.psm1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
