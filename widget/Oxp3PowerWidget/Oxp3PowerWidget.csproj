<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <ProjectGuid>{AC751371-61C3-47F0-9B0F-2A8908826F53}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <RootNamespace>Oxp3PowerWidget</RootNamespace>
    <AssemblyName>Oxp3PowerWidget</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == ''">10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <LangVersion>7.3</LangVersion>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxPackageDir>..\packages\uwp-6.2.14\</AppxPackageDir>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <UseDotNetNativeToolchain Condition="'$(Configuration)' == 'Release'">true</UseDotNetNativeToolchain>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <HelperPublishDirectory Condition="'$(HelperPublishDirectory)' == ''">..\..\artifacts\helper</HelperPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="App.cs" />
    <Compile Include="BridgeClient.cs" />
    <Compile Include="PowerPage.cs" />
    <Compile Include="..\..\shared\DeferredSlider.cs"><Link>DeferredSlider.cs</Link></Compile>
    <Compile Include="..\..\shared\PowerAvailability.cs"><Link>PowerAvailability.cs</Link></Compile>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\SplashScreen.png" />
    <Content Include="Assets\Icons\*.png" />
    <Content Include="Properties\Default.rd.xml" />
    <Content Include="$(HelperPublishDirectory)\**\*">
      <Link>Helper\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>
  <ItemGroup>
    <SDKReference Include="WindowsDesktop, Version=$(TargetPlatformVersion)" />
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2607010" />
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="[6.2.14]" />
  </ItemGroup>
  <PropertyGroup><XboxGameBar-Platform>x64</XboxGameBar-Platform></PropertyGroup>
  <Target Name="RequirePublishedHelper" BeforeTargets="Build">
    <Error Condition="!Exists('$(HelperPublishDirectory)\OXP3.PowerWidget.Helper.exe')" Text="Publish the helper before building the widget package." />
  </Target>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
