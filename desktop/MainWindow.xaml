<Window x:Class="Oxp3GamePower.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OXP3 Game Power — Test window" Width="480" Height="480" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" FontFamily="Segoe UI" FontSize="18" PreviewKeyDown="NavigateKey">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="44"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Border Height="6" Background="#4B585F" CornerRadius="3" VerticalAlignment="Center" Margin="10,0"/>
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="#1A9FFF" CornerRadius="3" VerticalAlignment="Center" Margin="10,0,0,0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F2F5F4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/><Setter Property="FontSize" Value="18"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="10,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center"/>
            <Border x:Name="Rail" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="#59636B">
              <Ellipse Fill="#F2F5F4" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0" x:Name="SwitchThumb"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="#1A9FFF"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="16,12">
    <StackPanel x:Name="MainPanel">
      <ContentControl x:Name="GameHeader" Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch" TabIndex="0">
      <Grid Margin="12,0" Height="40"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Image x:Name="GameIcon" Width="36" Height="36" Margin="0,0,10,0" Visibility="Collapsed"/>
        <TextBlock x:Name="GameName" Grid.Column="1" Text="No game running" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
      </Grid>
      </ContentControl>
      <CheckBox x:Name="PerGame" Content="Use per-game wattage" MinHeight="52" Click="ScopeChanged" Margin="0,12,0,6" TabIndex="1" IsEnabled="False" AutomationProperties.Name="Use per-game wattage"/>
      <Border x:Name="WattCard" Background="Transparent" BorderThickness="2" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Watts}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
        <StackPanel x:Name="WattControls">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Power limit (TDP)" FontSize="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="TargetWatts" Grid.Column="1" Text="— W" FontSize="22" FontWeight="SemiBold"/>
          </Grid>
          <Slider x:Name="Watts" Minimum="4" Maximum="35" Value="17" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="1" Margin="-10,7,-10,2" ValueChanged="TargetChanged" TabIndex="2" AutomationProperties.Name="Wattage"/>
          <Grid><TextBlock x:Name="MinimumWatts" Text="4 W" FontSize="14" Foreground="#8F9CA8"/><TextBlock x:Name="MaximumWatts" Text="35 W" FontSize="14" Foreground="#8F9CA8" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
        <TextBlock x:Name="PowerUnavailable" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Border>
      <Border BorderThickness="2" CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Brightness}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Brightness" FontSize="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="BrightnessValue" Grid.Column="1" Text="—%" FontSize="22" FontWeight="SemiBold"/>
          </Grid>
          <Slider x:Name="Brightness" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="1" Margin="-10,7,-10,2" ValueChanged="BrightnessChanged" TabIndex="3" IsEnabled="False" AutomationProperties.Name="Brightness"/>
        </StackPanel>
      </Border>
      <CheckBox x:Name="NightLight" Content="Night light" MinHeight="52" Click="NightLightChanged" Margin="0,12,0,0" TabIndex="4" IsEnabled="False" AutomationProperties.Name="Night light"/>
      <Border x:Name="StrengthCard" Visibility="Collapsed" BorderThickness="2" CornerRadius="4" Padding="10,6" Margin="0,12,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Strength}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Night light strength" FontSize="18" VerticalAlignment="Center"/>
            <TextBlock x:Name="StrengthValue" Grid.Column="1" Text="—%" FontSize="22" FontWeight="SemiBold"/>
          </Grid>
          <Slider x:Name="Strength" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="1" Margin="-10,7,-10,2" ValueChanged="StrengthChanged" TabIndex="5" IsEnabled="False" AutomationProperties.Name="Night light strength"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="Status" Visibility="Collapsed" FontSize="14" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
  </Grid>
</Window>
